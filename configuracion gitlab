gitlab_rails['smtp_enable'] = true
gitlab_rails['smtp_address'] = "mail.mavi.mx"
gitlab_rails['smtp_port'] = 26
# no van porque esta en un secret de gitlab-rake
# gitlab_rails['smtp_user_name'] = "user@mavi.mx"
